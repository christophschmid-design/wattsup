<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/wu_widget_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/wu_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/wu_dot" />
        <TextView
            android:id="@+id/wu_amp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Tagesampel"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher_round" />
    </LinearLayout>
    <TextView
        android:id="@+id/wu_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="WattsUp öffnen"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/wu_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#9FB3C8"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
