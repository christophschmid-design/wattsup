<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wu_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/wu_widget_bg">
    <LinearLayout android:id="@+id/wu_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/wu_dot" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/wu_dot" />
            <TextView android:id="@+id/wu_amp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Tagesampel" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ImageView android:id="@+id/wu_coachbtn" android:layout_width="30dp" android:layout_height="30dp" android:padding="3dp" android:src="@drawable/wu_whistle" android:contentDescription="Coach" />
        </LinearLayout>
        <TextView android:id="@+id/wu_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="WattsUp öffnen" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/wu_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#9FB3C8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wu_coach" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#E3B257" android:textSize="12.5sp" android:textStyle="italic" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wu_ask" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wu_q" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/wu_skip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="nicht trainiert ✕" android:textColor="#9FB3C8" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/wu_qs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#9FB3C8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/wb1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="1" />
            <TextView android:id="@+id/wb2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="2" />
            <TextView android:id="@+id/wb3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="3" />
            <TextView android:id="@+id/wb4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="4" />
            <TextView android:id="@+id/wb5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="5" />
            <TextView android:id="@+id/wb6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="6" />
            <TextView android:id="@+id/wb7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="7" />
            <TextView android:id="@+id/wb8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="8" />
            <TextView android:id="@+id/wb9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="9" />
            <TextView android:id="@+id/wb10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:background="@drawable/wu_btn" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="10" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
